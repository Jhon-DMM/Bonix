# Copia este archivo a ".env" y ajusta los valores.

# Cadena de conexión a MongoDB (local o Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/bonix

# Puerto donde corre la API.
PORT=4000

# Credenciales del único administrador. No las subas a Git.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Orígenes exactos autorizados para el frontend (separados por coma si hay varios).
FRONTEND_ORIGINS=http://localhost:5173

# Para despliegues en sitios distintos, configura SameSite=None y usa HTTPS.
ADMIN_COOKIE_SAME_SITE=lax
